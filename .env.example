# ============================================================================
# GreenShare — Environment Variables
#
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# ============================================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
# Server-only (อย่าเผยแพร่ให้ client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# ---- LINE LIFF (client-visible) ----
# รูปแบบ: {channelId}-{liffAppId} เช่น 1657123456-AbCdEfGh
NEXT_PUBLIC_LIFF_ID=1657123456-AbCdEfGh

# ---- LINE Login / Messaging (server-only) ----
# Channel ID ของ LINE Login channel (ใช้ verify ID token ฝั่งเซิร์ฟเวอร์)
# ถ้าไม่ระบุ จะดึงจาก NEXT_PUBLIC_LIFF_ID.split('-')[0] ให้อัตโนมัติ
LINE_LOGIN_CHANNEL_ID=1657123456

# Channel access token ของ Messaging API (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (ยังไม่ใช้ แต่ควรเตรียม) Channel secret สำหรับ verify webhook signature
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LINE UID ของแอดมินหลัก (รับ notification ระบบ)
ADMIN_LINE_UID=U1234567890abcdef...

# ---- App ----
NODE_ENV=development
